# ECDAT — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/
.env

# Node / Next.js
node_modules
node_modules/
**/node_modules
**/node_modules/**
*.nosync
**/*.nosync
.metadata_never_index
.next
.next/
**/.next
**/.next/**
out/
**/out/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment secrets — NEVER commit these
.env
.env.local
.env.*.local
backend/.env

# Binaries
backend/bin/cryptoscan
backend/bin/cryptoscan.exe

# Temporary scan uploads
tmp/
*.zip
!demo_enterprise_repo.zip
!demo_quantum_safe.zip
!official_test_codebases/*.zip
official_test_codebases/*/
backend/tmp/
core_banking_suite/
backend/ecdat.db
backend/ecdat.db-journal*
backend/ecdat.db-wal
backend/ecdat.db-shm

# OS files
.DS_Store
Thumbs.db

# IDE configs
.vscode/
.idea/
*.swp
*.swo

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.tsbuildinfo

# Generated exports (don't commit scan results)
*.cbom.json
*.pdf
exports/
