# DEMO sshd_config — QUANTUM VULNERABLE
# Intentionally insecure for ECDAT demo scanning
# DO NOT USE IN PRODUCTION

Port 22
Protocol 2

# ⚠️ QUANTUM VULNERABLE: RSA host key (BROKEN by Shor's Algorithm)
HostKey /etc/ssh/ssh_host_rsa_key
# ⚠️ QUANTUM VULNERABLE: ECDSA host key (BROKEN by Shor's Algorithm)
HostKey /etc/ssh/ssh_host_ecdsa_key

# ⚠️ QUANTUM VULNERABLE: Weak key exchange algorithms
# diffie-hellman-group1-sha1 uses 1024-bit DH — BROKEN classically and by Shor's
# diffie-hellman-group14-sha256 uses 2048-bit DH — BROKEN by Shor's
KexAlgorithms diffie-hellman-group1-sha1,diffie-hellman-group14-sha256,curve25519-sha256

# ⚠️ QUANTUM VULNERABLE: RSA and ECDSA host key algorithms
HostKeyAlgorithms ssh-rsa,ecdsa-sha2-nistp256,ssh-ed25519

# ⚠️ WEAK: Allows password authentication (brute force risk)
PasswordAuthentication yes
PermitRootLogin yes

# ⚠️ WEAK: Old MAC algorithms
MACs hmac-md5,hmac-sha1,hmac-sha2-256

# ⚠️ WEAK: No idle timeout
ClientAliveInterval 0
ClientAliveCountMax 0

# ⚠️ MISSING: AllowUsers / AllowGroups restriction
# AllowUsers admin deploy
